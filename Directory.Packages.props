<Project ToolsVersion="15.0">
  <!--
    To update the version of Uno, you should instead update the Sdk version in the global.json file.

    See https://aka.platform.uno/using-uno-sdk for more information.
    See https://aka.platform.uno/using-uno-sdk#implicit-packages for more information regarding the Implicit Packages.
  -->
  <ItemGroup>
    <PackageVersion Include="AutoMapper" Version="16.1.1" />
    <PackageVersion Include="Codepotatoes.Scraper.HowLongToBeat" Version="1.5.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.85.1" />
    <PackageVersion Include="Uno.Fonts.Fluent" Version="2.8.1" />
  </ItemGroup>
  <!--
    Tmds.DBus.Protocol used to be pinned here at 0.21.3 to dodge CVE GHSA-xrw6-gwf8-vvr9
    while keeping the Tmds.DBus.Protocol.Address type that Uno's X11 LinuxSystemThemeHelper
    hard-referenced (Address was removed in 0.22.0+). As of Uno.Sdk 6.6.x that pin is both
    unnecessary and actively harmful: Uno.WinUI.Runtime.Skia.X11 6.6.176 requires >= 0.92.0,
    so the downgrade fails restore with NU1605. 0.92.0 is the advisory's primary patched
    release, so the transitive resolution is safe on its own. Do NOT re-add the pin.

    AngleSharp is pulled in transitively by Codepotatoes.Scraper.HowLongToBeat (which is
    deprecated upstream and still asks for 1.4.0). 1.4.0 carries the mXSS bug in
    GHSA-pgww-w46g-26qg / CVE-2026-54570, fixed in 1.5.0 — hence the direct reference in
    Alua.csproj to float it. Alua only reads numeric playtimes off the scraped DOM and never
    re-serializes it into a WebView, so the bug isn't reachable here; this keeps the audit
    clean rather than fixing a live hole. 1.6.0 is the latest stable if you want to move up,
    but the scraper is unmaintained, so the minimal step off the CVE is the safer default.
  -->
  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.5.0" />
  </ItemGroup>
</Project>